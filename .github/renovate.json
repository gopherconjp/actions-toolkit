{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "description": "Track the pinned ghalint version in verify-actions/action.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/^verify-actions/action\\.yaml$/"],
      "matchStrings": ["GHALINT_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "suzuki-shunsuke/ghalint"
    },
    {
      "description": "Track the pinned oxfmt version in autofix workflow",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/autofix\\.yaml$/"],
      "matchStrings": ["OXFMT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "npm",
      "depNameTemplate": "oxfmt"
    }
  ],
  "packageRules": [
    {
      "description": "Auto merge all dependencies",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
